# build output
bin/
obj/

# the reference assembly is BUILT from ref/OpenUtau.Core.Facade/Facade.cs, not stored:
#   dotnet build ref/OpenUtau.Core.Facade -c Release
ref/**/bin/
ref/**/obj/
*.dll
*.pdb
*.runtimeconfig.json

# ...except the distributable. It is committed on purpose so the plugin can be downloaded
# without a .NET SDK; it is reproducible from the source in this repo (see dist/README.md).
!dist/*.dll

# editor / IDE
.vs/
.idea/
*.user
*.suo
.vscode/

# os
Thumbs.db
.DS_Store
